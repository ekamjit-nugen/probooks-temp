{
  "name": "probooks",
  "version": "0.0.0",
  "private": true,
  "description": "ProBooks — multi-firm SaaS bookkeeping/HST portal for Canadian accounting firms",
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "turbo": "2.1.3",
    "typescript": "5.6.2"
  }
}
