{
  "name": "@probooks/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "prisma generate && jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "10.4.4",
    "@nestjs/core": "10.4.4",
    "@nestjs/platform-express": "10.4.4",
    "@prisma/client": "5.20.0",
    "nestjs-pino": "4.1.0",
    "pino": "9.4.0",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.1.4",
    "@nestjs/testing": "10.4.4",
    "@probooks/config": "workspace:*",
    "@probooks/shared": "workspace:*",
    "@probooks/test-utils": "workspace:^",
    "@types/jest": "29.5.13",
    "@types/node": "22.7.4",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "eslint": "9.11.1",
    "jest": "29.7.0",
    "pg": "8.13.0",
    "pino-pretty": "11.2.2",
    "prisma": "5.20.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^@probooks/shared$": "<rootDir>/../../../packages/shared/src/index.ts",
      "^@probooks/test-utils$": "<rootDir>/../../../packages/test-utils/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.module.ts",
      "!**/main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
