# ProBooks API — example environment (STANDARDS §17).
# Copy to a local secrets source; NEVER commit a real .env.
# In dev/test these are read by core/config-env (the only sanctioned process.env reader).
# In staging/production these come from AWS Secrets Manager + Parameter Store (Wave 7).

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on (1-65535). Default: 3000
PORT=3000

# Pino log level: trace | debug | info | warn | error | fatal. Default: info
LOG_LEVEL=info

# Postgres connection strings (Wave 2). app_user = RLS-enforced (non-superuser);
# service_role = BYPASSRLS (platform/migrations). Real values come from Secrets Manager.
# DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/probooks
# DATABASE_SERVICE_ROLE_URL=postgresql://service_role:CHANGE_ME@localhost:5432/probooks

# Internal HS256 JWT signer (Wave 3, ADR-0005). ≥32 chars; from Secrets Manager in
# real envs — NEVER commit a real secret. Access ~15 min, refresh ~8 h (STANDARDS §10.1).
# JWT_SECRET=CHANGE_ME_at_least_32_characters_long_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=28800
